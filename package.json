{
  "name": "h3yun-cmax",
  "displayName": "H3Yun CMax",
  "description": "氚云低代码平台二开代码同步工具 - 自动从氚云平台同步应用代码到本地,实现版本管理和AI辅助开发",
  "version": "1.2.3",
  "publisher": "ChuckFu",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/chuck9090/h3yun-cmax.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:csharp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "h3yun-cmax.buildProject",
        "title": "从氚云构建项目"
      },
      {
        "command": "h3yun-cmax.syncProject",
        "title": "从氚云同步"
      },
      {
        "command": "h3yun-cmax.updateProjectToken",
        "title": "更新氚云 Token"
      },
      {
        "command": "h3yun-cmax.queryFormName",
        "title": "查询氚云表单名称"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "h3yun-cmax.buildProject"
        },
        {
          "command": "h3yun-cmax.syncProject",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "h3yun-cmax.updateProjectToken"
        },
        {
          "command": "h3yun-cmax.queryFormName",
          "when": "editorTextFocus && editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "h3yun-cmax.syncProject",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace"
        },
        {
          "command": "h3yun-cmax.updateProjectToken",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace"
        }
      ],
      "editor/context": [
        {
          "command": "h3yun-cmax.queryFormName",
          "when": "editorTextFocus && editorHasSelection",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/vsce": "^3.9.2",
    "@vue/compiler-sfc": "^3.3.0",
    "css-loader": "^6.8.0",
    "eslint": "^10.4.1",
    "sass": "^1.63.0",
    "sass-loader": "^13.3.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "vue": "^3.3.0",
    "vue-loader": "^17.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  }
}
